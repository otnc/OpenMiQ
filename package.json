{
  "name": "openmiq",
  "version": "1.0.0",
  "description": "Open Source Discord MiQ Bot (for self-host)",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otnc/OpenMiQ.git"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "self-hosted"
  ],
  "author": "otoneko. (https://github.com/otnc)",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "bugs": {
    "url": "https://github.com/otnc/OpenMiQ/issues"
  },
  "homepage": "https://github.com/otnc/OpenMiQ#readme",
  "scripts": {
    "test": "vitest run",
    "setup": "miq install all",
    "build": "tsdown",
    "dev": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/index.ts",
    "start": "node dist/index.js",
    "deploy:commands": "tsdown && node dist/deployCommandsCli.js",
    "deploy:images": "tsdown && node dist/deployImagesCli.js",
    "deploy": "tsdown && node dist/deploy.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs $(node -p \"require('./ecosystem.config.cjs').apps[0].name\")",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "checkupdates": "ncu"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "makeitaquote": "^12.1.1",
    "mustache": "^4.2.0",
    "pngjs": "^7.0.0",
    "pureimage": "^0.4.20",
    "quick-lru": "^7.3.0",
    "write-file-atomic": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.8",
    "@types/mustache": "^4.2.6",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/write-file-atomic": "^4.0.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "npm-check-updates": "^23.1.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
